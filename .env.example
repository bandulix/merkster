# ─────────────────────────────────────────────────────────────────────────────
# Merkster – server configuration.  Copy to `.env` and fill in.  NEVER commit `.env`.
# Every value is read only by the server; the browser never sees keys or the LLM URL.
# ─────────────────────────────────────────────────────────────────────────────

# --- runtime ------------------------------------------------------------------
NODE_ENV=production                 # production | development
PORT=8080                           # port the app listens on inside the container
PUBLIC_URL=http://localhost:8080    # the URL people open (https://… behind a reverse proxy)
TRUST_PROXY=false                   # true when running behind Caddy / nginx / Traefik
LOG_LEVEL=info                      # fatal | error | warn | info | debug
# COOKIE_SECURE=auto                # auto = Secure cookies when PUBLIC_URL is https

# Long random secret for sessions & signed URLs (≥ 32 chars):  openssl rand -hex 32
APP_SECRET=

# --- database (Postgres 16) ---------------------------------------------------
# docker compose builds DATABASE_URL from these; outside compose set DATABASE_URL directly.
POSTGRES_USER=merkster
POSTGRES_PASSWORD=                  # openssl rand -hex 24
POSTGRES_DB=merkster
# DATABASE_URL=postgres://merkster:<password>@localhost:5432/merkster
# DATABASE_SSL=false

# --- sign-in: Google only (OpenID Connect, PKCE + state + nonce) -------------
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorised redirect URI:  <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=              # default: <PUBLIC_URL>/api/auth/google/callback
REGISTRATION_OPEN=true              # false = only existing accounts / allowlist can sign in
# Codeword needed to CREATE a new account (shown as a "Codewort" field on the login page).
# Empty = no codeword (anyone allowed above can sign up). Existing accounts, ADMIN_EMAILS and
# supporters who open a valid invite link never need it. Case and surrounding spaces don't matter.
# Server-side only: never logged, never sent to the browser. Quote it if it contains " #".
SIGNUP_CODE=
# SIGNUP_CODE_MAX_ATTEMPTS=10       # wrong codewords per IP per 15 minutes before a short lock-out
# ALLOWED_EMAIL_DOMAINS=            # e.g. myschool.de,example.org (empty = any Google account)
# ALLOWLIST=                        # explicit e-mails allowed when registration is closed
ADMIN_EMAILS=                       # comma-separated admin e-mails (AI ping, stats)
# SESSION_DAYS=60

# TEST ONLY – mock Google provider (tools/mock-oidc.mjs, `docker compose --profile mock`).
# The server REFUSES to start with this set while NODE_ENV=production.
# OIDC_TEST_ISSUER=http://localhost:9090

# --- optional AI extraction (any OpenAI-compatible endpoint with vision) ------
# Without these the app uses on-device OCR (Tesseract) + manual report-card entry.
LLM_BASE_URL=                       # e.g. https://api.openai.com/v1
LLM_API_KEY=                        # server-side only; never logged, never sent to the browser
LLM_VISION_MODEL=                   # e.g. gpt-4o-mini
# LLM_TEXT_MODEL=                   # defaults to LLM_VISION_MODEL
# LLM_TIMEOUT_MS=120000
# LLM_JSON_MODE=auto                # auto | on | off (response_format=json_object)
# LLM_MAX_TOKENS=4000
# AI_RATE_LIMIT_PER_HOUR=30         # per user
# AI_RATE_LIMIT_PER_DAY=100         # per user

# --- license (GNU AGPL-3.0) --------------------------------------------------
# AGPL §13: if you run a (modified) Merkster for others, offer them its source. The app links here
# (login page + Settings → About). Point it at a PUBLIC copy of the exact version you run.
SOURCE_CODE_URL=https://github.com/bandulix/merkster

# --- limits -------------------------------------------------------------------
# MAX_UPLOAD_MB=8
# MAX_UPLOAD_FILES=10
# MAX_SYNC_MB=5
# AUTH_RATE_LIMIT_PER_10MIN=20

# --- Caddy override (docker-compose.caddy.yml) --------------------------------
# DOMAIN=merkster.example.org       # Caddy fetches a Let's Encrypt certificate for it
