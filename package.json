{
  "name": "merkster",
  "version": "1.0.0",
  "private": true,
  "description": "Merkster – snap your school material, practise like the real test, and earn a promised reward.",
  "type": "module",
  "main": "dist/server/index.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "dev:web": "npm run vendor && vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "npm run vendor && npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server/index.cjs",
    "migrate": "tsx server/src/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "mock-llm": "node tools/mock-llm.mjs",
    "mock-oidc": "node tools/mock-oidc.mjs"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tanstack/react-query": "^5.104.1",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@tesseract.js-data/lat": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "openid-client": "^6.8.8",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.4",
    "tesseract.js": "^5.1.1",
    "tesseract.js-core": "^5.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.5"
  }
}
