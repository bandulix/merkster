{
  "name": "snapwise",
  "version": "1.0.0",
  "private": true,
  "description": "Snapwise – snap your school material, practise like the real test.",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "dev:web": "npm run vendor && vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "npm run vendor && npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --target=node20 --format=cjs --packages=external --outfile=dist/server/index.cjs && node -e \"require('fs').cpSync('server/migrations','dist/server/migrations',{recursive:true})\"",
    "start": "node dist/server/index.cjs",
    "migrate": "tsx server/src/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "mock-llm": "node tools/mock-llm.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-query": "^5.104.1",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "@tesseract.js-data/lat": "^1.0.0",
    "@tesseract.js-data/spa": "^1.0.0",
    "fastify": "^5.12.5",
    "pdfjs-dist": "^3.11.174",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tesseract.js": "^5.1.1",
    "tesseract.js-core": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^2.1.9"
  }
}
